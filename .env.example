# Node 24+ on a persistent disk. Copy to .env.local; never commit secrets.
SITE_URL=http://localhost:3000
INQUIRY_DB_PATH=./data/inquiries.sqlite
# Default placeholder only; hidden unless verified is true.
CONTACT_PHONE=+18336969996
CONTACT_PHONE_VERIFIED=false
# Optional HTTPS webhook that sends team notifications; payload includes personal data.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
# Set ONLY if your reverse proxy strips and overwrites this header.
TRUSTED_CLIENT_IP_HEADER=
RETENTION_DAYS=90
